{
  "name": "playplugin-sdk",
  "version": "0.1.0",
  "description": "PlayPlugin TypeScript SDK for the PlayPlugin native overlay player (RTSP/FLV/HLS, H.264/H.265) for web pages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "LGPL-2.1-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JianWWW/play-plugin.git",
    "directory": "sdk"
  }
}
